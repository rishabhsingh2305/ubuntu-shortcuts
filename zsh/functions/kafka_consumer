kafka_consumer() {
  emulate -L zsh

  if (( $# < 1 )) || [[ -z $1 ]]; then
    print -u2 "Usage: kafka_consumer <topic> [extra consumer args...]"
    return 1
  fi

  local topic=$1
  shift
  local kafka_home=${KAFKA_HOME:-/opt/kafka}
  local bin="$kafka_home/bin/kafka-console-consumer.sh"

  if [[ ! -x $bin ]]; then
    print -u2 "kafka_consumer: not found: $bin (set KAFKA_HOME)"
    return 1
  fi

  "$bin" --bootstrap-server "${KAFKA_BOOTSTRAP_SERVERS:-localhost:9092}" \
    --topic "$topic" --from-beginning "$@"
}
