kafka_producer() {
  emulate -L zsh

  if (( $# < 1 )) || [[ -z $1 ]]; then
    print -u2 "Usage: kafka_producer <topic> [extra producer args...]"
    return 1
  fi

  local topic=$1
  shift
  local kafka_home=${KAFKA_HOME:-/opt/kafka}
  local bin="$kafka_home/bin/kafka-console-producer.sh"

  if [[ ! -x $bin ]]; then
    print -u2 "kafka_producer: not found: $bin (set KAFKA_HOME)"
    return 1
  fi

  "$bin" --bootstrap-server "${KAFKA_BOOTSTRAP_SERVERS:-localhost:9092}" \
    --topic "$topic" "$@"
}
